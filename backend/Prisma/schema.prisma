// All Market Ethiopia - Prisma Schema
// Phase 1 + 2 Foundation
// Strictly follows the master prompt data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  am
  en
}

enum AccountType {
  individual
  business
}

enum VerificationStatus {
  none
  pending
  verified
}

enum AdminRole {
  none
  moderator
  ad_manager
  super_admin
}

enum UserStatus {
  active
  suspended
  banned
}

enum ListingStatus {
  draft
  pending_review
  active
  sold
  expired
  removed
}

enum Currency {
  ETB
}

enum MediaType {
  photo
  video
}

enum ReportReason {
  scam
  spam
  fake_product
  duplicate_listing
  harassment
  other
}

enum ReportStatus {
  pending
  reviewed
  action_taken
  dismissed
}

enum CreditReason {
  daily_grant
  listing_post
  ad_watch_reward
  task_reward
  admin_grant
  admin_deduction
}

enum AdType {
  banner
  featured_listing
  sponsored_listing
  rewarded_video
}

enum AdPlacement {
  home_top
  home_feed
  search_results
  listing_detail
  rewarded_slot
}

enum AdStatus {
  active
  paused
  ended
}

enum AdEventType {
  impression
  view
  completed_view
  click
}

model User {
  id                String             @id @default(uuid())
  telegramId        BigInt             @unique @map("telegram_id")
  telegramUsername  String?            @map("telegram_username")
  firstName         String?            @map("first_name")
  lastName          String?            @map("last_name")
  profilePhotoUrl   String?            @map("profile_photo_url")
  fullName          String?            @map("full_name")
  phonePrimary      String?            @map("phone_primary")
  phoneSecondary    String?            @map("phone_secondary")
  email             String?
  region            String?
  city              String?
  bio               String?
  businessName      String?            @map("business_name")
  languagePreference Language          @default(en) @map("language_preference")
  accountType       AccountType        @default(individual) @map("account_type")
  verificationStatus VerificationStatus @default(none) @map("verification_status")
  isAdmin           Boolean            @default(false) @map("is_admin")
  adminRole         AdminRole          @default(none) @map("admin_role")
  status            UserStatus         @default(active)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  listings          Listing[]
  favorites         Favorite[]
  reviewsGiven      Review[]           @relation("Reviewer")
  reviewsReceived   Review[]           @relation("Seller")
  reportsMade       Report[]           @relation("Reporter")
  reportsReceived   Report[]           @relation("ReportedUser")
  creditLedger      CreditLedger[]
  resolvedReports   Report[]           @relation("ResolvedBy")

  @@map("users")
}

model Listing {
  id              String        @id @default(uuid())
  sellerId        String        @map("seller_id")
  title           String
  description     String
  price           Decimal       @db.Decimal(12, 2)
  priceNegotiable Boolean       @default(true) @map("price_negotiable")
  currency        Currency      @default(ETB)
  categoryId      String        @map("category_id")
  region          String
  city            String
  contactPhone    String?       @map("contact_phone")
  status          ListingStatus @default(pending_review)
  isFeatured      Boolean       @default(false) @map("is_featured")
  featuredUntil   DateTime?     @map("featured_until")
  viewCount       Int           @default(0) @map("view_count")
  favoriteCount   Int           @default(0) @map("favorite_count")
  reportCount     Int           @default(0) @map("report_count")
  expiresAt       DateTime?     @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  seller          User          @relation(fields: [sellerId], references: [id])
  category        Category      @relation(fields: [categoryId], references: [id])
  media           ListingMedia[]
  favorites       Favorite[]
  reviews         Review[]
  reports         Report[]

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([region, city])
  @@index([sellerId])
  @@map("listings")
}

model ListingMedia {
  id           String    @id @default(uuid())
  listingId    String    @map("listing_id")
  type         MediaType @default(photo)
  url          String
  thumbnailUrl String?   @map("thumbnail_url")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_media")
}

model Category {
  id        String     @id @default(uuid())
  key       String     @unique // e.g. "electronics" - used for i18n
  icon      String?
  parentId  String?    @map("parent_id")
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  listings  Listing[]

  @@map("categories")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("favorites")
}

model Review {
  id         String   @id @default(uuid())
  reviewerId String   @map("reviewer_id")
  sellerId   String   @map("seller_id")
  listingId  String?  @map("listing_id")
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  seller     User     @relation("Seller", fields: [sellerId], references: [id])
  listing    Listing? @relation(fields: [listingId], references: [id])

  @@unique([reviewerId, sellerId, listingId])
  @@index([sellerId])
  @@map("reviews")
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String       @map("reporter_id")
  listingId      String?      @map("listing_id")
  reportedUserId String?      @map("reported_user_id")
  reason         ReportReason
  description    String?
  status         ReportStatus @default(pending)
  resolvedById   String?      @map("resolved_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  resolvedAt     DateTime?    @map("resolved_at")

  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])
  listing        Listing?     @relation(fields: [listingId], references: [id])
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])
  resolvedBy     User?        @relation("ResolvedBy", fields: [resolvedById], references: [id])

  @@index([status])
  @@map("reports")
}

model CreditLedger {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  amount      Int          // positive = earned, negative = spent
  reason      CreditReason
  balanceAfter Int         @map("balance_after")
  createdAt   DateTime     @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("credit_ledger")
}

model CreditConfig {
  id                 Int      @id @default(1) // singleton
  dailyFreeCredits   Int      @default(3) @map("daily_free_credits")
  costPerListing     Int      @default(1) @map("cost_per_listing")
  adWatchReward      Int      @default(1) @map("ad_watch_reward")
  maxAdRewardsPerDay Int      @default(5) @map("max_ad_rewards_per_day")
  taskRewardAmounts  Json?    @map("task_reward_amounts")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("credit_config")
}

model Advertisement {
  id             String      @id @default(uuid())
  type           AdType
  title          String?
  creativeUrl    String?     @map("creative_url")
  targetUrl      String?     @map("target_url")
  placement      AdPlacement
  advertiserName String?     @map("advertiser_name")
  startDate      DateTime?   @map("start_date")
  endDate        DateTime?   @map("end_date")
  status         AdStatus    @default(active)
  createdById    String?     @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  events         AdEvent[]

  @@map("advertisements")
}

model AdEvent {
  id        String      @id @default(uuid())
  adId      String      @map("ad_id")
  userId    String?     @map("user_id")
  eventType AdEventType @map("event_type")
  createdAt DateTime    @default(now()) @map("created_at")

  ad        Advertisement @relation(fields: [adId], references: [id])

  @@index([adId, eventType])
  @@index([createdAt])
  @@map("ad_events")
}

model PlatformSetting {
  key   String @id
  value Json

  @@map("platform_settings")
}
